(package
  (name (samizdat))
  (version "0.7.3")
  (description "A markup for writing, after Racket's Scribble: @name[args]{text}, read into a tree any converter can print.")
  (license "MPL-2.0")

  ;; The reader is written with bjorsec's combinators. To work on both at once,
  ;; give (bjorsec) a path source in your own manifest: the root manifest's
  ;; source wins.
  (depends
    (package (name (bjorsec))
             (version (version-at-least "0.2.1"))
             (source (git (url "https://github.com/bjoli/bjorsec"))))
    ;; @markdown. It brings Markdig as a NuGet package, so building anything
    ;; with samizdat needs the .NET SDK's dotnet command.
    (package (name (markdig-bjolang))
             (version (version-at-least "0.2.0"))
             (source (git (url "https://github.com/bjoli/markdig-bjolang"))))
    ;; Highlighted code blocks in HTML. It brings TextMateSharp as a NuGet
    ;; package, with Oniguruma as a native library.
    (package (name (textmate-bjolang))
             (version (version-at-least "0.1.3"))
             (source (git (url "https://rikspucko.koketteriet.se/bjoli/textmate-bjolang")))))

  ;; A library: there is no src/main.bjo, so `bjo build` builds every module
  ;; under src/ rather than a program.
  )
