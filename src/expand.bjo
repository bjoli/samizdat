;; samizdat/src/expand.bjo — the module (samizdat expand).
;;
;; Runs a document's commands, and turns what they made into a `Document`.
;;
;; A command is an ordinary function, and a table of them is an ordinary map
;; from names to functions: a program that wants `@youtube` writes one and
;; puts it in the map. What makes that enough is that a command gets its call
;; *unexpanded* — its arguments and its body as they were read — and decides
;; what to do with them:
;;
;;     `@em` expands its body as text and wraps it,
;;     `@code` takes its body as it is written,
;;     `@note` expands its body as paragraphs and puts them somewhere else,
;;     `@comment` ignores it.
;;
;; A command answers with pieces, each an inline or a block. Text between
;; them is inline. At the top level, and in any body expanded as blocks, the
;; inlines are gathered into paragraphs: a blank line ends one, and so does a
;; block. So a writer never says where a paragraph is.
;;
;; A command that is given something it cannot use calls `refuse`, and the whole
;; expansion answers `(Err "post.sz:14:3: @link: ...")`.

(export
  Piece Command Ctx
  ;; Running a document.
  expand read-document read-document-file
  ;; Answering: a command returns (Vec Piece).
  inline block nothing
  ;; The body.
  has-body? body-items body-text expand-inlines expand-blocks expand-items
  items->blocks items->inlines
  ;; Answering once the document is finished: a table of contents, a reference.
  defer-blocks defer-inlines
  ;; Other files, relative to the document being expanded.
  include-file relative-path read-relative
  ;; The arguments.
  positional keyword arg-count arg-string arg-string-or
  kw-string-or kw-int-or kw-bool-or kw-symbol-or check-keywords!
  ;; Refusing. Not called `fail`, which `(std simpletest)` has.
  refuse
  ;; The document's state.
  add-note! unique-id! ctx-source
  ;; Commands made from less.
  text-command
  ;; What the typography pass does, on its own.
  smarten)

(import (std prelude))
(import (text bjodat-core))
(import (samizdat read))
(import (samizdat doc))

(import/class
  ;; What `refuse` raises, and the only exception `expand` turns into an `Err`:
  ;; anything else a command raises is a bug in it, and goes on up.
  (Refused (: System.IO.InvalidDataException (-> string Refused))))

;; ---------------------------------------------------------------------------
;; Commands, and what they run in
;; ---------------------------------------------------------------------------

(type (: Piece (Union (PInline Inline)
                      (PBlock Block))))

;; What a deferred command makes of the finished document.
(type (: Later (Union (LaterBlocks (-> Document (Vec Block)))
                      (LaterInlines (-> Document (Vec Inline))))))

;; `commands` is the table the document is expanded with. `source` is what a
;; message calls the file being expanded — the document, or one it includes —
;; and `including` the files being included, outermost first. `notes` are the
;; footnotes so far (a slot is `None` while its note is being expanded), `ids`
;; how many times each heading id has been handed out, and `later` the
;; deferred commands, each with the source it was written in.
(type-rec
  (: Command (Alias (-> Ctx Call (Vec Piece))))
  (: Ctx #:opaque (Record (: commands (Map string Command))
                          (: source string #:mutable)
                          (: including (Vec string) #:mutable)
                          (: notes (Vec (Option (Vec Block))) #:mutable)
                          (: ids (Map string int) #:mutable)
                          (: depth int #:mutable)
                          (: later (Vec (Tuple string Later)) #:mutable))))

(: ctx-source (-> Ctx string))
(defun (ctx-source cx) (record-ref cx source))

;; How deep commands may run inside commands. A body read from a file cannot
;; nest this deep; a command that expands itself can.
(: max-depth int)
(def max-depth 200)

;; ---------------------------------------------------------------------------
;; Refusing
;; ---------------------------------------------------------------------------

;; Stops the expansion with a message that says where the command is.
(: refuse (-> Ctx Call string %a))
(defun (refuse cx c why)
  (raise (cast Exception
               (Refused. (str (record-ref cx source) ":" (int->string (record-ref c line))
                              ":" (int->string (record-ref c column)) ": @" (record-ref c name)
                              ": " why)))))

;; ---------------------------------------------------------------------------
;; Answering
;; ---------------------------------------------------------------------------

(: inline (-> Inline (Vec Piece)))
(defun (inline x) (vec-add (vec-empty) (PInline x)))

(: block (-> Block (Vec Piece)))
(defun (block x) (vec-add (vec-empty) (PBlock x)))

(: nothing (Vec Piece))
(def nothing (vec-empty))

;; A command that stands for some text: `(text-command "Bjolang")` for
;; `@bjolang`. It takes no arguments and no body.
(: text-command (-> string Command))
(defun (text-command text)
  (fun (cx c)
    (when (or (has-body? c) (> (arg-count c) 0))
      (refuse cx c "takes no arguments and no body"))
    (inline (Str text))))

;; ---------------------------------------------------------------------------
;; Expanding
;; ---------------------------------------------------------------------------

(: expand-items (-> Ctx (Vec At) (Vec Piece)))
(defun (expand-items cx items)
  (loop (:for item items)
        (:acc out (folding (vec-empty) (vec-merge out (expand-item cx item))))))

(: expand-item (-> Ctx At (Vec Piece)))
(defun (expand-item cx item)
  (match item
    ((Text s) (inline (Str s)))
    ((Cmd c) (run-command cx c))))

(: run-command (-> Ctx Call (Vec Piece)))
(defun (run-command cx c)
  (match (map-try-ref (record-ref cx commands) (record-ref c name))
    (None (refuse cx c "there is no such command"))
    ((Some command)
     (def depth (record-ref cx depth))
     (when (>= depth max-depth)
       (refuse cx c (str "commands are running more than " (int->string max-depth) " deep")))
     (record-set! cx (depth (+ depth 1)))
     (def pieces (command cx c))
     (record-set! cx (depth depth))
     pieces)))

(: has-body? (-> Call bool))
(defun (has-body? c)
  (match (record-ref c body)
    ((Some items) #t)
    (None #f)))

;; The body as it was read, empty when there was none.
(: body-items (-> Call (Vec At)))
(defun (body-items c)
  (match (record-ref c body)
    ((Some items) items)
    (None (vec-empty))))

;; The body as text: what was written, with any command in it expanded and
;; taken as text. A command in it that makes a block is refused.
(: body-text (-> Ctx Call string))
(defun (body-text cx c)
  (string-join (vec-map (fun (item)
                          (match item
                            ((Text s) s)
                            ((Cmd inner) (inlines->text (as-inlines cx inner (run-command cx inner))))))
                        (body-items c))
               ""))

;; The body expanded as text. A block in it is refused.
(: expand-inlines (-> Ctx Call (Vec Inline)))
(defun (expand-inlines cx c)
  (merge-strs (as-inlines cx c (expand-items cx (body-items c)))))

(: as-inlines (-> Ctx Call (Vec Piece) (Vec Inline)))
(defun (as-inlines cx c pieces)
  (vec-map (fun (p)
             (match p
               ((PInline x) x)
               ((PBlock b) (refuse cx c "has a block in it, where only text can go"))))
           pieces))

;; The body expanded as blocks, its text gathered into paragraphs.
(: expand-blocks (-> Ctx Call (Vec Block)))
(defun (expand-blocks cx c)
  (items->blocks cx (body-items c)))

;; Items of any provenance — a part of a body a command has taken apart —
;; expanded into paragraphs and blocks.
(: items->blocks (-> Ctx (Vec At) (Vec Block)))
(defun (items->blocks cx items)
  (decode (expand-items cx items)))

;; The same, expanded as text: a block among them is refused, as `c`'s.
(: items->inlines (-> Ctx Call (Vec At) (Vec Inline)))
(defun (items->inlines cx c items)
  (merge-strs (as-inlines cx c (expand-items cx items))))

;; ---------------------------------------------------------------------------
;; Paragraphs
;; ---------------------------------------------------------------------------

;; Adjacent strings as one, and no empty ones.
(: merge-strs (-> (Vec Inline) (Vec Inline)))
(defun (merge-strs xs)
  (loop (:for x xs)
        (:acc out (folding (vec-empty) (push-inline out x)))))

(: push-inline (-> (Vec Inline) Inline (Vec Inline)))
(defun (push-inline out x)
  (match x
    ((Str s)
     (cond
       ((string-empty? s) out)
       ((vec-empty? out) (vec-add out x))
       (else
        (def last (- (vec-length out) 1))
        (match (vec-ref out last)
          ((Str before) (vec-set out last (Str (str before s))))
          (_ (vec-add out x))))))
    (_ (vec-add out x))))

;; Adjacent text as one piece. Two runs of text with a command between them
;; that made nothing — a comment — are one run, so a blank line is found even
;; when it is split across them.
(: merge-pieces (-> (Vec Piece) (Vec Piece)))
(defun (merge-pieces pieces)
  (loop (:for p pieces)
        (:acc out (folding (vec-empty) (push-piece out p)))))

(: push-piece (-> (Vec Piece) Piece (Vec Piece)))
(defun (push-piece out p)
  (match p
    ((PInline (Str s))
     (if (vec-empty? out)
         (vec-add out p)
         (let ((last (- (vec-length out) 1)))
           (match (vec-ref out last)
             ((PInline (Str before)) (vec-set out last (PInline (Str (str before s)))))
             (_ (vec-add out p))))))
    (_ (vec-add out p))))

;; The text split where it has a blank line. The first line and the last are
;; not candidates: the first is the rest of a line that began before this
;; text, and the last the start of one that goes on after it.
(: paragraphs (-> string (Vec string)))
(defun (paragraphs s)
  (def lines (string-split s "\n"))
  (def n (vec-length lines))
  (match (loop (:for i (range 0 n))
               (:acc st (folding (Tuple (vec-empty) (vec-empty) #f)
                                 (split-step st (vec-ref lines i) (and (> i 0) (< i (- n 1)))))))
    ((Tuple parts current broken) (vec-add parts (string-join current "\n")))))

(: split-step (-> (Tuple (Vec string) (Vec string) bool) string bool
                  (Tuple (Vec string) (Vec string) bool)))
(defun (split-step st line inner?)
  (match st
    ((Tuple parts current broken)
     (cond
       ((and inner? (string-empty? (string-trim line))) (Tuple parts current #t))
       (broken (Tuple (vec-add parts (string-join current "\n")) (vec-add (vec-empty) line) #f))
       (else (Tuple parts (vec-add current line) #f))))))

;; Leading whitespace off the first string and trailing off the last, and a
;; string that was nothing else is gone.
(: trim-inlines (-> (Vec Inline) (Vec Inline)))
(defun (trim-inlines xs)
  (trim-end (trim-start xs)))

(: trim-start (-> (Vec Inline) (Vec Inline)))
(defun (trim-start xs)
  (if (vec-empty? xs)
      xs
      (match (vec-ref xs 0)
        ((Str s)
         (def t (string-trim-start s))
         (if (string-empty? t) (trim-start (vec-remove-at xs 0)) (vec-set xs 0 (Str t))))
        (_ xs))))

(: trim-end (-> (Vec Inline) (Vec Inline)))
(defun (trim-end xs)
  (if (vec-empty? xs)
      xs
      (let ((last (- (vec-length xs) 1)))
        (match (vec-ref xs last)
          ((Str s)
           (def t (string-trim-end s))
           (if (string-empty? t) (trim-end (vec-remove-at xs last)) (vec-set xs last (Str t))))
          (_ xs)))))

(: flush (-> (Vec Block) (Vec Inline) (Vec Block)))
(defun (flush blocks para)
  (def trimmed (trim-inlines (merge-strs para)))
  (if (vec-empty? trimmed) blocks (vec-add blocks (Para trimmed))))

(: decode-step (-> (Tuple (Vec Block) (Vec Inline)) Piece (Tuple (Vec Block) (Vec Inline))))
(defun (decode-step st p)
  (match st
    ((Tuple blocks para)
     (match p
       ((PBlock b) (Tuple (vec-add (flush blocks para) b) (vec-empty)))
       ((PInline (Str s))
        (def parts (paragraphs s))
        (let go ((i 1)
                 (done blocks)
                 (current (vec-add para (Str (vec-ref parts 0)))))
          (if (>= i (vec-length parts))
              (Tuple done current)
              (go (+ i 1) (flush done current) (vec-add (vec-empty) (Str (vec-ref parts i)))))))
       ((PInline x) (Tuple blocks (vec-add para x)))))))

;; Pieces to blocks: inlines gathered into paragraphs, which a blank line or a
;; block ends.
(: decode (-> (Vec Piece) (Vec Block)))
(defun (decode pieces)
  (match (loop (:for p (merge-pieces pieces))
               (:acc st (folding (Tuple (vec-empty) (vec-empty)) (decode-step st p))))
    ((Tuple blocks para) (flush blocks para))))

;; ---------------------------------------------------------------------------
;; Arguments
;; ---------------------------------------------------------------------------
;; `@image["cat.png" #:alt "A cat" left]`: "cat.png" and left are positional,
;; and #:alt is a keyword with the value after it.

(: keyword-name (-> Keyword string))
(defun (keyword-name k)
  (def s (keyword->string k))
  (cond
    ((string-starts-with? s "#:") (.Substring s 2))
    ((string-starts-with? s ":") (.Substring s 1))
    (else s)))

;; The arguments that are not keywords or a keyword's value.
(: positional (-> Call (Vec Bjodat)))
(defun (positional c)
  (def args (record-ref c args))
  (let go ((i 0) (out (vec-empty)))
    (cond
      ((>= i (vec-length args)) out)
      (else
       (match (vec-ref args i)
         ((BjoKey k) (go (+ i 2) out))
         (v (go (+ i 1) (vec-add out v))))))))

(: arg-count (-> Call int))
(defun (arg-count c) (vec-length (positional c)))

;; The value after `#:name`, the first time it is given.
(: keyword (-> Call string (Option Bjodat)))
(defun (keyword c name)
  (def args (record-ref c args))
  (let go ((i 0))
    (cond
      ((>= i (vec-length args)) None)
      (else
       (match (vec-ref args i)
         ((BjoKey k)
          (cond
            ((not (= (keyword-name k) name)) (go (+ i 2)))
            ((< (+ i 1) (vec-length args)) (Some (vec-ref args (+ i 1))))
            (else None)))
         (v (go (+ i 1))))))))

;; Refuses a keyword not among `names`, and one with no value after it, so
;; that a misspelt `#:langauge` says so rather than being ignored.
(: check-keywords! (-> Ctx Call (Vec string) void))
(defun (check-keywords! cx c names)
  (def args (record-ref c args))
  (let go ((i 0))
    (when (< i (vec-length args))
      (match (vec-ref args i)
        ((BjoKey k)
         (def name (keyword-name k))
         (unless (vec-contains names name)
           (refuse cx c (str "takes no #:" name
                           (if (vec-empty? names)
                               ""
                               (str "; it takes #:" (string-join names ", #:"))))))
         (unless (< (+ i 1) (vec-length args))
           (refuse cx c (str "#:" name " has no value after it")))
         (go (+ i 2)))
        (v (go (+ i 1)))))))

;; A string or a symbol, as text.
(: as-text (-> Bjodat (Option string)))
(defun (as-text v)
  (match v
    ((BjoStr s) (Some s))
    ((BjoSym s) (Some (symbol->string s)))
    (_ None)))

(: arg-string-or (-> Ctx Call int string string))
(defun (arg-string-or cx c i fallback)
  (def args (positional c))
  (if (>= i (vec-length args))
      fallback
      (match (as-text (vec-ref args i))
        ((Some s) s)
        (None (refuse cx c (str "argument " (int->string (+ i 1)) " should be a string, and is "
                              (bjodat->string (vec-ref args i))))))))

;; The `i`th positional argument, counting from 0, which must be there.
(: arg-string (-> Ctx Call int string))
(defun (arg-string cx c i)
  (if (>= i (arg-count c))
      (refuse cx c (str "needs " (int->string (+ i 1)) " argument" (if (= i 0) "" "s")
                      " in its [...]"))
      (arg-string-or cx c i "")))

(: kw-string-or (-> Ctx Call string string string))
(defun (kw-string-or cx c name fallback)
  (match (keyword c name)
    (None fallback)
    ((Some v)
     (match (as-text v)
       ((Some s) s)
       (None (refuse cx c (str "#:" name " should be a string, and is " (bjodat->string v))))))))

;; A symbol or a string, compared as text: `#:style ordered`.
(: kw-symbol-or (-> Ctx Call string string string))
(defun (kw-symbol-or cx c name fallback) (kw-string-or cx c name fallback))

(: kw-int-or (-> Ctx Call string int int))
(defun (kw-int-or cx c name fallback)
  (match (keyword c name)
    (None fallback)
    ((Some (BjoInt n)) (cast System.Int32 n))
    ((Some v) (refuse cx c (str "#:" name " should be a whole number, and is " (bjodat->string v))))))

(: kw-bool-or (-> Ctx Call string bool bool))
(defun (kw-bool-or cx c name fallback)
  (match (keyword c name)
    (None fallback)
    ((Some (BjoBool b)) b)
    ((Some v) (refuse cx c (str "#:" name " should be #t or #f, and is " (bjodat->string v))))))

;; ---------------------------------------------------------------------------
;; The document's state
;; ---------------------------------------------------------------------------

;; Adds a footnote and answers its number. `make` expands it: its number is
;; taken first, so a note inside a note comes after it.
(: add-note! (-> Ctx (-> (Vec Block)) int))
(defun (add-note! cx make)
  (def slot (vec-length (record-ref cx notes)))
  (record-set! cx (notes (vec-add (record-ref cx notes) None)))
  (def blocks (make))
  (record-set! cx (notes (vec-set (record-ref cx notes) slot (Some blocks))))
  (+ slot 1))

;; An id made from `text`, which no other call has answered: "The Defaults"
;; is "the-defaults", and the second one "the-defaults-2".
(: unique-id! (-> Ctx string string))
(defun (unique-id! cx text)
  (def made (slug text))
  (def base (if (string-empty? made) "section" made))
  (def ids (record-ref cx ids))
  (let go ((n (map-ref-or ids base 0)))
    (def candidate (if (= n 0) base (str base "-" (int->string (+ n 1)))))
    (if (and (> n 0) (map-contains? ids candidate))
        (go (+ n 1))
        (begin
          (record-set! cx (ids (map-set (map-set ids base (+ n 1)) candidate 1)))
          candidate))))

;; Letters and digits, lower-cased, with a dash where there was space or a dash.
(: slug (-> string string))
(defun (slug text)
  (def b (stringbuilder-empty))
  (string-for-each (fun (c)
                     (cond
                       ((or (char-alphabetic? c) (char-numeric? c))
                        (stringbuilder-add-string! b (string-downcase (char->string c))))
                       ((or (char-whitespace? c) (char=? c #\-) (char=? c #\_))
                        (stringbuilder-add! b #\-))
                       (else unit)))
                   text)
  (string-join (vec-filter (fun (part) (not (string-empty? part)))
                           (string-split (stringbuilder->string b) "-"))
               "-"))

;; ---------------------------------------------------------------------------
;; Later: what needs the finished document
;; ---------------------------------------------------------------------------
;; A table of contents lists headings that come after it, and a reference may
;; point at a section further on. A command that needs the whole document
;; answers with `defer-blocks` or `defer-inlines`: a placeholder now, and a
;; function that the finished document is handed to once every command has
;; run. What it makes goes where the placeholder was.
;;
;; The placeholder is a `Div` or a `Span` whose class begins with a NUL, which
;; nothing written in a document can make, and none is left in what `expand`
;; answers.

(: later-mark string)
(def later-mark (str (char->string (integer->char 0)) "later:"))

(: later-class (-> int string))
(defun (later-class n) (str later-mark (int->string n)))

;; The number in a placeholder's class, when it is one.
(: later-number (-> string (Option int)))
(defun (later-number class)
  (if (string-starts-with? class later-mark)
      (Some (string->int (.Substring class (string-length later-mark))))
      None))

(: later! (-> Ctx Later int))
(defun (later! cx what)
  (def n (vec-length (record-ref cx later)))
  (record-set! cx (later (vec-add (record-ref cx later) (Tuple (record-ref cx source) what))))
  n)

(: defer-blocks (-> Ctx (-> Document (Vec Block)) (Vec Piece)))
(defun (defer-blocks cx make)
  (block (Div (later-class (later! cx (LaterBlocks make))) (vec-empty))))

(: defer-inlines (-> Ctx (-> Document (Vec Inline)) (Vec Piece)))
(defun (defer-inlines cx make)
  (inline (Span (later-class (later! cx (LaterInlines make))) (vec-empty))))

;; Runs `thunk` as if in the file `source`, so that a refusal names it.
(: in-source (-> Ctx string (-> %a) %a))
(defun (in-source cx source thunk)
  (def before (record-ref cx source))
  (record-set! cx (source source))
  (def result (thunk))
  (record-set! cx (source before))
  result)

;; The placeholders replaced by what their functions make of `doc`. What a
;; function makes is resolved in turn — a table of contents lists a heading
;; that holds a reference — except for a placeholder already being resolved,
;; which is left out rather than resolved forever.
(: resolve-blocks (-> Ctx Document (Vec int) (Vec Block) (Vec Block)))
(defun (resolve-blocks cx doc active bs)
  (loop (:for b bs)
        (:acc out (folding (vec-empty) (vec-merge out (resolve-block cx doc active b))))))

(: resolve-block (-> Ctx Document (Vec int) Block (Vec Block)))
(defun (resolve-block cx doc active b)
  (match b
    ((Div class bs)
     (match (later-number class)
       ((Some n)
        (if (vec-contains active n)
            (vec-empty)
            (match (vec-ref (record-ref cx later) n)
              ((Tuple source (LaterBlocks make))
               (resolve-blocks cx doc (vec-add active n) (in-source cx source (fun () (make doc)))))
              (_ (vec-empty)))))
       (None [(Div class (resolve-blocks cx doc active bs))])))
    ((Para xs) [(Para (resolve-inlines cx doc active xs))])
    ((Heading level id xs) [(Heading level id (resolve-inlines cx doc active xs))])
    ((Quote bs) [(Quote (resolve-blocks cx doc active bs))])
    ((ItemList numbered items)
     [(ItemList numbered (vec-map (fun (item) (resolve-blocks cx doc active item)) items))])
    ((TableBlock t) [(TableBlock (map-table-text (fun (xs) (resolve-inlines cx doc active xs)) t))])
    (_ [b])))

(: resolve-inlines (-> Ctx Document (Vec int) (Vec Inline) (Vec Inline)))
(defun (resolve-inlines cx doc active xs)
  (loop (:for x xs)
        (:acc out (folding (vec-empty) (vec-merge out (resolve-inline cx doc active x))))))

(: resolve-inline (-> Ctx Document (Vec int) Inline (Vec Inline)))
(defun (resolve-inline cx doc active x)
  (match x
    ((Span class xs)
     (match (later-number class)
       ((Some n)
        (if (vec-contains active n)
            (vec-empty)
            (match (vec-ref (record-ref cx later) n)
              ((Tuple source (LaterInlines make))
               (resolve-inlines cx doc (vec-add active n) (in-source cx source (fun () (make doc)))))
              (_ (vec-empty)))))
       (None [(Span class (resolve-inlines cx doc active xs))])))
    ((Emph xs) [(Emph (resolve-inlines cx doc active xs))])
    ((Strong xs) [(Strong (resolve-inlines cx doc active xs))])
    ((Strike xs) [(Strike (resolve-inlines cx doc active xs))])
    ((Link url xs) [(Link url (resolve-inlines cx doc active xs))])
    (_ [x])))

;; ---------------------------------------------------------------------------
;; Other files
;; ---------------------------------------------------------------------------

(import/extern
  (directory-of (: System.IO.Path.GetDirectoryName (-> string string))))

;; `path` as a document writes it: relative to the directory the file being
;; expanded is in. A document read from a string, rather than from a file, is
;; in the current directory.
(: relative-path (-> Ctx string string))
(defun (relative-path cx path)
  (def source (record-ref cx source))
  (def dir (if (string-empty? source) "" (directory-of source)))
  (if (string-empty? dir) path (path-combine dir path)))

;; The text of the file at `path`, relative to the document. A file that is not
;; there is refused, as the command's mistake.
(: read-relative (-> Ctx Call string string))
(defun (read-relative cx c path)
  (def full (relative-path cx path))
  (unless (file-exists? full) (refuse cx c (str "there is no file " full)))
  (file-read-text full))

;; The document at `path`, expanded where the command is, as if its text were
;; written there. It shares the document's footnotes and heading ids. It may
;; not have a (meta ...) of its own, and may not include itself, however far
;; round; a refusal inside it says where it was included from.
(: include-file (-> Ctx Call string (Vec Piece)))
(defun (include-file cx c path)
  (def full (relative-path cx path))
  (def chain (record-ref cx including))
  (when (vec-contains (vec-map path-absolute chain) (path-absolute full))
    (refuse cx c (str full " is already being included: "
                      (string-join (vec-add chain full) " -> "))))
  (def text (read-relative cx c path))
  (match (read-source text #:name full)
    ((Err e) (refuse cx c e))
    ((Ok src)
     (match (record-ref src meta)
       ((Some m) (refuse cx c (str full " begins with (meta ...), which only the document itself may")))
       (None unit))
     (def here (str (record-ref cx source) ":" (int->string (record-ref c line))
                    ":" (int->string (record-ref c column))))
     (record-set! cx (including (vec-add chain full)))
     (def result (try (in-source cx full (fun () (expand-items cx (record-ref src content))))
                      #:catch (System.IO.InvalidDataException)))
     (record-set! cx (including chain))
     (match result
       ((Ok pieces) pieces)
       ((Err e) (raise (cast Exception (Refused. (str (.-Message e) "\n  included from " here)))))))))

;; ---------------------------------------------------------------------------
;; Typography
;; ---------------------------------------------------------------------------
;; In text, not in code: `---` is an em dash, `--` an en dash, `...` an
;; ellipsis, and straight quotes are curly — opening after a space, a bracket
;; or a dash, closing otherwise. What came before is carried across inlines, so
;; the quote after `@em{word}` closes.

(: opens-after? (-> char bool))
(defun (opens-after? c)
  (or (char-whitespace? c)
      (char=? c #\() (char=? c #\[) (char=? c #\{)
      (char=? c #\—) (char=? c #\–) (char=? c #\“) (char=? c #\‘)))

;; The text made typographic, and the last character of it.
(: smarten-text (-> string char (Tuple string char)))
(defun (smarten-text s before)
  (def dashed (string-replace (string-replace (string-replace s "---" "—") "--" "–") "..." "…"))
  (def b (stringbuilder-empty))
  (def last
    (string-fold (fun (c prev)
                   (def out (cond
                              ((char=? c #\") (if (opens-after? prev) #\“ #\”))
                              ((char=? c #\') (if (opens-after? prev) #\‘ #\’))
                              (else c)))
                   (stringbuilder-add! b out)
                   out)
                 before
                 dashed))
  (Tuple (stringbuilder->string b) last))

(: smarten-inlines (-> (Vec Inline) char (Tuple (Vec Inline) char)))
(defun (smarten-inlines xs before)
  (loop (:for x xs)
        (:acc st (folding (Tuple (vec-empty) before)
                          (match st
                            ((Tuple out prev)
                             (match (smarten-inline x prev)
                               ((Tuple y last) (Tuple (vec-add out y) last)))))))))

(: smarten-inline (-> Inline char (Tuple Inline char)))
(defun (smarten-inline x before)
  (match x
    ((Str s) (match (smarten-text s before) ((Tuple t last) (Tuple (Str t) last))))
    ((Emph xs) (match (smarten-inlines xs before) ((Tuple ys last) (Tuple (Emph ys) last))))
    ((Strong xs) (match (smarten-inlines xs before) ((Tuple ys last) (Tuple (Strong ys) last))))
    ((Strike xs) (match (smarten-inlines xs before) ((Tuple ys last) (Tuple (Strike ys) last))))
    ((Link url xs) (match (smarten-inlines xs before) ((Tuple ys last) (Tuple (Link url ys) last))))
    ((Span c xs) (match (smarten-inlines xs before) ((Tuple ys last) (Tuple (Span c ys) last))))
    (LineBreak (Tuple x #\space))
    (_ (Tuple x #\x))))

(: smarten-line (-> (Vec Inline) (Vec Inline)))
(defun (smarten-line xs)
  (match (smarten-inlines xs #\space) ((Tuple ys last) ys)))

(: smarten-block (-> Block Block))
(defun (smarten-block b)
  (match b
    ((Para xs) (Para (smarten-line xs)))
    ((Heading level id xs) (Heading level id (smarten-line xs)))
    ((Quote bs) (Quote (smarten bs)))
    ((ItemList numbered items) (ItemList numbered (vec-map smarten items)))
    ((Div c bs) (Div c (smarten bs)))
    ((TableBlock t) (TableBlock (map-table-text smarten-line t)))
    (_ b)))

(: smarten (-> (Vec Block) (Vec Block)))
(defun (smarten blocks) (vec-map smarten-block blocks))

;; ---------------------------------------------------------------------------
;; A document
;; ---------------------------------------------------------------------------

;; Runs the commands of a document that has been read. `#:name` is what a
;; message calls it; `#:typography #f` leaves dashes and quotes as they were
;; typed.
(: expand (-> Source (Map string Command) (#:name string) (#:typography bool)
              (Result string Document)))
(defun (expand src commands #:name "input" #:typography #t)
  (def cx (Ctx (commands commands) (source name) (including [name]) (notes (vec-empty))
               (ids (map-empty)) (depth 0) (later (vec-empty))))
  (match (try (finish cx src) #:catch (System.IO.InvalidDataException))
    ((Err e) (Err (.-Message e)))
    ((Ok doc)
     (Ok (if typography
             (Document (meta (record-ref doc meta))
                       (blocks (smarten (record-ref doc blocks)))
                       (notes (vec-map smarten (record-ref doc notes))))
             doc)))))

;; Every command run, and then what was deferred, given the document as it
;; stood when every command had run.
(: finish (-> Ctx Source Document))
(defun (finish cx src)
  (def blocks (decode (expand-items cx (record-ref src content))))
  (def notes (vec-map (fun (n) (option-ref-or n (vec-empty))) (record-ref cx notes)))
  (def before (Document (meta (record-ref src meta)) (blocks blocks) (notes notes)))
  (Document (meta (record-ref src meta))
            (blocks (resolve-blocks cx before (vec-empty) blocks))
            (notes (vec-map (fun (n) (resolve-blocks cx before (vec-empty) n)) notes))))

;; Reads a document and runs its commands.
(: read-document (-> string (Map string Command) (#:name string) (#:typography bool)
                     (Result string Document)))
(defun (read-document text commands #:name "input" #:typography #t)
  (match (read-source text #:name name)
    ((Err e) (Err e))
    ((Ok src) (expand src commands #:name name #:typography typography))))

(: read-document-file (-> string (Map string Command) (#:typography bool)
                          (Result string Document)))
(defun (read-document-file path commands #:typography #t)
  (read-document (file-read-text path) commands #:name path #:typography typography))
