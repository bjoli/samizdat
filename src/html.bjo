;; file, You can obtain one at http://mozilla.org/MPL/2.0/.

;; samizdat/src/html.bjo — the module (samizdat html).
;;
;; A converter: a `Document` as HTML. It is one converter among the ones you
;; might write, and has no say in anything before it — a command does not
;; know this module exists.
;;
;; The document becomes (text xml) nodes — SXML — and the nodes become text:
;;
;;     (document->nodes doc)           the body of a page as nodes: blocks, then notes
;;     (document->html doc)            the same, written as HTML
;;     (html-page doc #:title "...")   a whole page around it
;;     (nodes->html nodes)             any nodes, written as HTML
;;
;; What it makes, and what to style:
;;
;;     a section heading     <h2 id="...">, one level below the page's <h1>;
;;                           #:heading-offset 0 makes it <h1>
;;     a code block          <pre><code class="language-scheme">, the class
;;                           highlight.js and Prism look for; highlighted
;;                           here instead when there is a #:highlighter
;;     a span, a div         <span class="kbd">, <div class="aside">
;;     a footnote            <sup class="note-ref"><a href="#note-1">1</a></sup>,
;;                           and <section class="notes"> at the end
;;     raw text              passed through when its format is "html", and
;;                           left out when it is anything else
;;
;; A hook takes over one kind of block or inline. It is asked first, and
;; answers `None` for what it leaves to the converter, or the nodes it makes:
;;
;;     (html-options #:block-hook
;;       (fun (h b)
;;         (match b
;;           ((Div "aside" bs) (Some (list (html-element "aside" Nil (blocks->nodes h bs)))))
;;           (_ None))))
;;
;; `#:id-prefix` goes in front of every id this writes, and every link to one
;; (an href that begins with #), so that two documents on one page — a blog's
;; front page — do not share a `note-1`.
;;
;; `#:highlighter` is a TextMate highlighter from textmate-bjolang, which
;; colours a code block in its language: `#:highlight-style 'inline` writes
;; the theme's colours into the page, `'classes` class names, whose stylesheet
;; `highlighter-css` writes.
;;
;; The writer is HTML's, not XML's: `<br>`, not `<br />`, and an empty element
;; is `<td></td>`, since HTML would read `<td />` as an open tag. An element
;; whose children include blocks puts each block on a line of its own; text
;; is never touched, and nothing inside a <pre> is. Raw HTML stays raw inside
;; the tree as an element in a namespace of its own, which only this writer
;; knows: `raw-html` for text, `raw-html-block` for a block.
;;
;; Open:
;; - The writer knows HTML's void, block, boolean-attribute and raw-text
;;   elements by name. Another writer — a (text html) in the standard
;;   library, say — would want the same tables.
;; - A raw node is opaque. Nothing checks that what it holds is HTML, and a
;;   converter walking the nodes cannot look inside one.

(export
  Html html-options default-html
  document->nodes blocks->nodes inlines->nodes
  document->html blocks->html inlines->html html-page
  nodes->html html-element raw-html raw-html-block
  escape-html escape-attribute)

;; What a hook is written with, so that it needs no import of (text xml),
;; whose `Document` is not samizdat's.
(re-export Node xml-text)

(import (std prelude))
(import (only (std hashset) list->hashset hashset-contains?))
(import (only (text xml) xml-name xml-name-local xml-name-ns xml-element xml-text element-view
              text? text-value comment? comment-value text-content))
(import (only (textmate-bjolang core) code->node))
;; After (text xml): a bare type name means the later import's, and
;; `Document` here is samizdat's.
(import (samizdat doc))

;; ---------------------------------------------------------------------------
;; Options
;; ---------------------------------------------------------------------------

(type-rec
  (: Html #:opaque (Record (: offset int)
                           (: prefix string)
                           (: block-hook (-> Html Block (Option (List Node))))
                           (: inline-hook (-> Html Inline (Option (List Node))))
                           (: highlighter (Option TmHighlighter))
                           (: highlight-style TmStyleMode))))

(: no-block-hook (-> Html Block (Option (List Node))))
(defun (no-block-hook h b) None)

(: no-inline-hook (-> Html Inline (Option (List Node))))
(defun (no-inline-hook h i) None)

(: html-options (-> (#:heading-offset int) (#:id-prefix string)
                    (#:block-hook (-> Html Block (Option (List Node))))
                    (#:inline-hook (-> Html Inline (Option (List Node))))
                    (#:highlighter (Option TmHighlighter))
                    (#:highlight-style TmStyleMode)
                    Html))
(defun (html-options #:heading-offset 1 #:id-prefix ""
                     #:block-hook no-block-hook #:inline-hook no-inline-hook
                     #:highlighter None #:highlight-style 'inline)
  (Html (offset heading-offset) (prefix id-prefix) (block-hook block-hook) (inline-hook inline-hook)
        (highlighter highlighter) (highlight-style highlight-style)))

(: default-html Html)
(def default-html (html-options))

;; ---------------------------------------------------------------------------
;; Names
;; ---------------------------------------------------------------------------
;; Made once: xml-name checks each one.

(: tag (-> string XmlName))
(defun (tag name) (xml-name name))

(def a-tag (tag "a"))
(def blockquote-tag (tag "blockquote"))
(def body-tag (tag "body"))
(def br-tag (tag "br"))
(def caption-tag (tag "caption"))
(def code-tag (tag "code"))
(def dd-tag (tag "dd"))
(def del-tag (tag "del"))
(def div-tag (tag "div"))
(def dl-tag (tag "dl"))
(def dt-tag (tag "dt"))
(def em-tag (tag "em"))
(def figcaption-tag (tag "figcaption"))
(def figure-tag (tag "figure"))
(def head-tag (tag "head"))
(def hr-tag (tag "hr"))
(def html-tag (tag "html"))
(def img-tag (tag "img"))
(def input-tag (tag "input"))
(def li-tag (tag "li"))
(def meta-tag (tag "meta"))
(def ol-tag (tag "ol"))
(def p-tag (tag "p"))
(def pre-tag (tag "pre"))
(def section-tag (tag "section"))
(def span-tag (tag "span"))
(def strong-tag (tag "strong"))
(def sub-tag (tag "sub"))
(def sup-tag (tag "sup"))
(def table-tag (tag "table"))
(def tbody-tag (tag "tbody"))
(def td-tag (tag "td"))
(def th-tag (tag "th"))
(def thead-tag (tag "thead"))
(def title-tag (tag "title"))
(def tr-tag (tag "tr"))
(def ul-tag (tag "ul"))

(: heading-tags (Vec XmlName))
(def heading-tags (vec-map tag ["h1" "h2" "h3" "h4" "h5" "h6"]))

(def alt-attr (tag "alt"))
(def charset-attr (tag "charset"))
(def checked-attr (tag "checked"))
(def class-attr (tag "class"))
(def content-attr (tag "content"))
(def disabled-attr (tag "disabled"))
(def href-attr (tag "href"))
(def id-attr (tag "id"))
(def lang-attr (tag "lang"))
(def name-attr (tag "name"))
(def src-attr (tag "src"))
(def start-attr (tag "start"))
(def style-attr (tag "style"))
(def type-attr (tag "type"))

;; ---------------------------------------------------------------------------
;; Nodes for a hook, and raw HTML
;; ---------------------------------------------------------------------------

;; An element named by strings: (html-element "a" (list (Tuple "href" "/")) kids).
;; A boolean attribute is given its own name as its value, (Tuple "open" "open"),
;; and written bare.
(: html-element (-> string (List (Tuple string string)) (List Node) Node))
(defun (html-element name attrs children)
  (xml-element (xml-name name)
               (list-map (fun (a) (match a ((Tuple k v) (Tuple (xml-name k) v)))) attrs)
               children))

;; Raw HTML is an element in this namespace, holding the markup as its text.
;; A namespace no HTML element has, so no hook's element can be taken for one.
(: raw-namespace string)
(def raw-namespace "urn:samizdat:raw-html")

(def raw-inline-tag (xml-name "inline" #:ns raw-namespace))
(def raw-block-tag (xml-name "block" #:ns raw-namespace))

;; Markup written as it is, among text.
(: raw-html (-> string Node))
(defun (raw-html markup) (xml-element raw-inline-tag Nil (list (xml-text markup))))

;; Markup written as it is, on a line of its own among blocks.
(: raw-html-block (-> string Node))
(defun (raw-html-block markup) (xml-element raw-block-tag Nil (list (xml-text markup))))

;; ---------------------------------------------------------------------------
;; Escaping
;; ---------------------------------------------------------------------------

;; `&` first, or the ampersands the others put in are escaped a second time.
(: escape-html (-> string string))
(defun (escape-html s)
  (string-replace (string-replace (string-replace s "&" "&amp;") "<" "&lt;") ">" "&gt;"))

(: escape-attribute (-> string string))
(defun (escape-attribute s)
  (string-replace (escape-html s) "\"" "&quot;"))

(: id (-> Html string string))
(defun (id h s) (str (record-ref h prefix) s))

;; A link to `#something` is to an id in this document, which has the prefix
;; too: a table of contents and a reference keep working under `#:id-prefix`.
(: href (-> Html string string))
(defun (href h url)
  (if (string-starts-with? url "#")
      (str "#" (id h (.Substring url 1)))
      url))

;; ---------------------------------------------------------------------------
;; Inlines
;; ---------------------------------------------------------------------------
;; Built as vecs, which grow at the end, and handed over as the lists
;; xml-element takes.

(: inline-vec (-> Html (Vec Inline) (Vec Node)))
(defun (inline-vec h xs)
  (loop (:for x xs)
        (:acc out (folding (vec-empty) (vec-merge out (inline-nodes h x))))))

(: inlines->nodes (-> Html (Vec Inline) (List Node)))
(defun (inlines->nodes h xs) (vec->list (inline-vec h xs)))

(: inline-nodes (-> Html Inline (Vec Node)))
(defun (inline-nodes h x)
  (match ((record-ref h inline-hook) h x)
    ((Some nodes) (list->vec nodes))
    (None (plain-inline h x))))

(: around (-> XmlName Html (Vec Inline) (Vec Node)))
(defun (around name h xs) [(xml-element name Nil (inlines->nodes h xs))])

(: image (-> string string Node))
(defun (image src alt) (xml-element img-tag (list (Tuple src-attr src) (Tuple alt-attr alt)) Nil))

(: plain-inline (-> Html Inline (Vec Node)))
(defun (plain-inline h x)
  (match x
    ((Str s) [(xml-text s)])
    ((Emph xs) (around em-tag h xs))
    ((Strong xs) (around strong-tag h xs))
    ((Strike xs) (around del-tag h xs))
    ((Superscript xs) (around sup-tag h xs))
    ((Subscript xs) (around sub-tag h xs))
    ((Checkbox checked)
     (def attrs (list (Tuple type-attr "checkbox") (Tuple disabled-attr "disabled")))
     [(xml-element input-tag (if checked (list-append attrs (list (Tuple checked-attr "checked"))) attrs) Nil)])
    ((Code s) [(xml-element code-tag Nil (list (xml-text s)))])
    ((Link url xs) [(xml-element a-tag (list (Tuple href-attr (href h url))) (inlines->nodes h xs))])
    ((Image src alt) [(image src alt)])
    (LineBreak [(xml-element br-tag Nil Nil)])
    ((NoteRef n)
     (def k (int->string n))
     [(xml-element sup-tag (list (Tuple class-attr "note-ref"))
                   (list (xml-element a-tag (list (Tuple id-attr (id h (str "note-ref-" k)))
                                                  (Tuple href-attr (str "#" (id h (str "note-" k)))))
                                      (list (xml-text k)))))])
    ((Span c xs) [(xml-element span-tag (list (Tuple class-attr c)) (inlines->nodes h xs))])
    ((RawInline format s) (if (= format "html") [(raw-html s)] (vec-empty)))
    ((Anchor aid) [(xml-element a-tag (list (Tuple id-attr (id h aid))) Nil)])))

;; ---------------------------------------------------------------------------
;; Blocks
;; ---------------------------------------------------------------------------

(: block-vec (-> Html (Vec Block) (Vec Node)))
(defun (block-vec h bs)
  (loop (:for b bs)
        (:acc out (folding (vec-empty) (vec-merge out (block-nodes h b))))))

(: blocks->nodes (-> Html (Vec Block) (List Node)))
(defun (blocks->nodes h bs) (vec->list (block-vec h bs)))

(: block-nodes (-> Html Block (Vec Node)))
(defun (block-nodes h b)
  (match ((record-ref h block-hook) h b)
    ((Some nodes) (list->vec nodes))
    (None (plain-block h b))))

(: heading-tag (-> Html int XmlName))
(defun (heading-tag h level)
  (def n (+ level (record-ref h offset)))
  (vec-ref heading-tags (- (cond ((< n 1) 1) ((> n 6) 6) (else n)) 1)))

;; A paragraph first, and nothing after it but lists.
(: tight? (-> (Vec Block) bool))
(defun (tight? item)
  (and (not (vec-empty? item))
       (match (vec-ref item 0)
         ((Para xs)
          (loop (:for i (range 1 (vec-length item)))
                (:acc ok (folding #t (and ok (match (vec-ref item i)
                                               ((ItemList numbered start items) #t)
                                               (_ #f)))))))
         (_ #f))))

;; An item that is one paragraph, and perhaps lists after it, is written
;; without the <p>, as a list of short items — or a table of contents — is
;; written by hand. So is a definition.
(: item-node (-> Html XmlName (Vec Block) Node))
(defun (item-node h name item)
  (xml-element name Nil
               (vec->list
                 (if (tight? item)
                     (match (vec-ref item 0)
                       ((Para xs) (vec-merge (inline-vec h xs) (block-vec h (vec-remove-at item 0))))
                       (_ (block-vec h item)))
                     (block-vec h item)))))

;; Without a highlighter, the code in a <code> with its language as a class;
;; with one, the <pre> and <code> textmate-bjolang makes, coloured.
(: code-block (-> Html string string Node))
(defun (code-block h lang text)
  (match (record-ref h highlighter)
    ((Some hl) (code->node hl lang text #:style (record-ref h highlight-style)))
    (None
     (xml-element pre-tag Nil
                  (list (xml-element code-tag
                                     (if (string-empty? lang) Nil (list (Tuple class-attr (str "language-" lang))))
                                     (list (xml-text text))))))))

;; The lines, a <br> and a newline between each.
(: line-block (-> Html (Vec (Vec Inline)) Node))
(defun (line-block h lines)
  (def kids (loop (:for line lines)
                  (:for i (up-from 0))
                  (:acc out (folding (vec-empty)
                                     (vec-merge (if (= i 0) out (vec-merge out [(xml-element br-tag Nil Nil) (xml-text "\n")]))
                                                (inline-vec h line))))))
  (xml-element div-tag (list (Tuple class-attr "line-block")) (vec->list kids)))

(: definition-list (-> Html (Vec (Tuple (Vec Inline) (Vec (Vec Block)))) Node))
(defun (definition-list h entries)
  (def kids (loop (:for entry entries)
                  (:acc out (folding (vec-empty)
                                     (match entry
                                       ((Tuple term defs)
                                        (vec-merge (vec-add out (xml-element dt-tag Nil (inlines->nodes h term)))
                                                   (vec-map (fun (d) (item-node h dd-tag d)) defs))))))))
  (xml-element dl-tag Nil (vec->list kids)))

(: plain-block (-> Html Block (Vec Node)))
(defun (plain-block h b)
  (match b
    ((Para xs) [(xml-element p-tag Nil (inlines->nodes h xs))])
    ((Heading level hid xs)
     [(xml-element (heading-tag h level) (list (Tuple id-attr (id h hid))) (inlines->nodes h xs))])
    ((UnnumberedHeading level xs) [(xml-element (heading-tag h level) Nil (inlines->nodes h xs))])
    ((Figure src alt xs)
     [(xml-element figure-tag Nil
                   (if (vec-empty? xs)
                       (list (image src alt))
                       (list (image src alt) (xml-element figcaption-tag Nil (inlines->nodes h xs)))))])
    ((CodeBlock lang text) [(code-block h lang text)])
    ((Quote bs) [(xml-element blockquote-tag Nil (blocks->nodes h bs))])
    ((ItemList numbered start items)
     [(xml-element (if numbered ol-tag ul-tag)
                   (if (and numbered (> start 1)) (list (Tuple start-attr (int->string start))) Nil)
                   (vec->list (vec-map (fun (item) (item-node h li-tag item)) items)))])
    ((LineBlock lines) [(line-block h lines)])
    ((DefinitionList entries) [(definition-list h entries)])
    (Rule [(xml-element hr-tag Nil Nil)])
    ((Div c bs) [(xml-element div-tag (list (Tuple class-attr c)) (blocks->nodes h bs))])
    ((RawBlock format s) (if (= format "html") [(raw-html-block s)] (vec-empty)))
    ((TableBlock t) [(table-node h t)])))

;; A <table>: the caption, the head in a <thead>, and each group of the rest
;; in a <tbody> of its own, as Org exports one.
(: table-node (-> Html Table Node))
(defun (table-node h t)
  (def aligns (record-ref t aligns))
  (def caption (record-ref t caption))
  (def head (record-ref t head))
  (def parts
    (vec-merge
      (vec-merge (if (vec-empty? caption) (vec-empty) [(xml-element caption-tag Nil (inlines->nodes h caption))])
                 (if (vec-empty? head) (vec-empty) [(xml-element thead-tag Nil (rows h th-tag aligns head))]))
      (vec-map (fun (group) (xml-element tbody-tag Nil (rows h td-tag aligns group))) (record-ref t bodies))))
  (xml-element table-tag Nil (vec->list parts)))

(: rows (-> Html XmlName (Vec Align) (Vec (Vec (Vec Inline))) (List Node)))
(defun (rows h cell aligns rs)
  (vec->list (vec-map (fun (r) (row h cell aligns r)) rs)))

(: align-style (-> Align string))
(defun (align-style a)
  (match a
    (AlignDefault "")
    (AlignLeft "text-align: left")
    (AlignCenter "text-align: center")
    (AlignRight "text-align: right")))

;; A cell past the end of `aligns` is set as the browser pleases.
(: row (-> Html XmlName (Vec Align) (Vec (Vec Inline)) Node))
(defun (row h cell aligns r)
  (xml-element tr-tag Nil
               (loop (:for c r)
                     (:for i (up-from 0))
                     (:let style (align-style (if (< i (vec-length aligns)) (vec-ref aligns i) AlignDefault)))
                     (:acc (listing (xml-element cell
                                                 (if (string-empty? style) Nil (list (Tuple style-attr style)))
                                                 (inlines->nodes h c)))))))

;; ---------------------------------------------------------------------------
;; Notes, and a document
;; ---------------------------------------------------------------------------

;; A note's blocks, with the link back to where it was referred to at the end
;; of its last paragraph, or after its last block when that is not one.
(: note-node (-> Html int (Vec Block) Node))
(defun (note-node h n blocks)
  (def k (int->string n))
  (def back (xml-element a-tag (list (Tuple class-attr "note-back") (Tuple href-attr (str "#" (id h (str "note-ref-" k)))))
                         (list (xml-text "↩"))))
  (def count (vec-length blocks))
  (def body
    (if (= count 0)
        [back]
        (match (vec-ref blocks (- count 1))
          ((Para xs)
           (vec-add (block-vec h (vec-remove-at blocks (- count 1)))
                    (xml-element p-tag Nil (vec->list (vec-merge (inline-vec h xs) [(xml-text " ") back])))))
          (_ (vec-add (block-vec h blocks) back)))))
  (xml-element li-tag (list (Tuple id-attr (id h (str "note-" k)))) (vec->list body)))

(: notes-node (-> Html (Vec (Vec Block)) Node))
(defun (notes-node h notes)
  (xml-element section-tag (list (Tuple class-attr "notes"))
               (list (xml-element ol-tag Nil
                                  (loop (:for n (up-from 1))
                                        (:for note notes)
                                        (:acc (listing (note-node h n note))))))))

;; The blocks, then the notes if there are any: what goes in a page's <body>,
;; or an <article> in one.
(: document->nodes (-> Document (#:with Html) (List Node)))
(defun (document->nodes doc #:with default-html)
  (def body (block-vec with (record-ref doc blocks)))
  (def notes (record-ref doc notes))
  (vec->list (if (vec-empty? notes) body (vec-add body (notes-node with notes)))))

(: document->html (-> Document (#:with Html) string))
(defun (document->html doc #:with default-html)
  (nodes->html (document->nodes doc #:with with)))

(: blocks->html (-> Html (Vec Block) string))
(defun (blocks->html h bs) (nodes->html (blocks->nodes h bs)))

(: inlines->html (-> Html (Vec Inline) string))
(defun (inlines->html h xs) (nodes->html (inlines->nodes h xs)))

;; A whole page. The title is `#:title`, or the meta form's `(title ...)`;
;; `#:head` is put in the <head> as it is — a stylesheet, say.
(: html-page (-> Document (#:with Html) (#:title string) (#:head string) (#:lang string) string))
(defun (html-page doc #:with default-html #:title "" #:head "" #:lang "en")
  (def title-text (if (string-empty? title) (option-ref-or (meta-string doc "title") "") title))
  (def head-nodes
    (list-append
      (list (xml-element meta-tag (list (Tuple charset-attr "utf-8")) Nil)
            (xml-element meta-tag (list (Tuple name-attr "viewport")
                                        (Tuple content-attr "width=device-width, initial-scale=1"))
                         Nil)
            (xml-element title-tag Nil (list (xml-text title-text))))
      (if (string-empty? head) Nil (list (raw-html-block head)))))
  (str "<!DOCTYPE html>\n"
       (nodes->html (list (xml-element html-tag (list (Tuple lang-attr lang))
                                       (list (xml-element head-tag Nil head-nodes)
                                             (xml-element body-tag Nil (document->nodes doc #:with with))))))
       "\n"))

;; ---------------------------------------------------------------------------
;; The writer
;; ---------------------------------------------------------------------------

;; Elements with no end tag, and no children.
(: void-elements (HashSet string))
(def void-elements
  (list->hashset (list "area" "base" "br" "col" "embed" "hr" "img" "input" "link" "meta" "source" "track" "wbr")))

;; Elements that go on lines of their own when they stand among blocks. Not
;; <figcaption>, <td> or <th>, which stay on the line of what holds them.
(: block-elements (HashSet string))
(def block-elements
  (list->hashset (list "address" "article" "aside" "blockquote" "body" "caption" "dd" "details" "dialog"
                   "div" "dl" "dt" "fieldset" "figure" "footer" "form" "h1" "h2" "h3" "h4" "h5" "h6"
                   "head" "header" "hgroup" "hr" "html" "li" "link" "main" "menu" "meta" "nav" "ol"
                   "p" "pre" "script" "search" "section" "style" "summary" "table" "tbody" "tfoot"
                   "thead" "title" "tr" "ul")))

;; Attributes that mean something by being there, written bare when their
;; value is empty or their own name.
(: boolean-attributes (HashSet string))
(def boolean-attributes
  (list->hashset (list "allowfullscreen" "async" "autofocus" "autoplay" "checked" "controls" "default"
                   "defer" "disabled" "formnovalidate" "hidden" "inert" "ismap" "itemscope" "loop"
                   "multiple" "muted" "nomodule" "novalidate" "open" "playsinline" "readonly"
                   "required" "reversed" "selected")))

;; Elements whose text is not HTML, and is written unescaped.
(: raw-text-elements (HashSet string))
(def raw-text-elements (list->hashset (list "script" "style")))

(: raw-marker? (-> XmlName bool))
(defun (raw-marker? name) (= (xml-name-ns name) raw-namespace))

(: block-node? (-> Node bool))
(defun (block-node? n)
  (match (element-view n)
    ((Some (Tuple name attrs kids))
     (if (raw-marker? name)
         (= name raw-block-tag)
         (hashset-contains? block-elements (string-downcase (xml-name-local name)))))
    (None #f)))

;; Text that is "", and raw HTML with none in it, write nothing, and must not
;; be given a line either.
(: shown? (-> Node bool))
(defun (shown? n)
  (cond
    ((text? n) (not (string-empty? (text-value n))))
    (else (match (element-view n)
            ((Some (Tuple name attrs kids)) (or (not (raw-marker? name)) (not (string-empty? (text-content n)))))
            (None #t)))))

(: write-attributes! (-> StringBuilder XmlAttrs void))
(defun (write-attributes! sb attrs)
  (list-for-each
    (fun (a)
      (match a
        ((Tuple k v)
         (def name (xml-name-local k))
         (stringbuilder-add-string! sb " ")
         (stringbuilder-add-string! sb name)
         (unless (and (hashset-contains? boolean-attributes name) (or (string-empty? v) (= v name)))
           (stringbuilder-add-string! sb "=\"")
           (stringbuilder-add-string! sb (escape-attribute v))
           (stringbuilder-add-string! sb "\"")))))
    attrs))

(: write-node! (-> StringBuilder Node bool void))
(defun (write-node! sb n pre?)
  (match (element-view n)
    ((Some (Tuple name attrs kids))
     (if (raw-marker? name)
         (stringbuilder-add-string! sb (text-content n))
         (let ((local (xml-name-local name)))
           (stringbuilder-add-string! sb "<")
           (stringbuilder-add-string! sb local)
           (write-attributes! sb attrs)
           (stringbuilder-add-string! sb ">")
           (unless (hashset-contains? void-elements (string-downcase local))
             (if (hashset-contains? raw-text-elements (string-downcase local))
                 (stringbuilder-add-string! sb (text-content n))
                 (write-children! sb kids #t (or pre? (= (string-downcase local) "pre"))))
             (stringbuilder-add-string! sb "</")
             (stringbuilder-add-string! sb local)
             (stringbuilder-add-string! sb ">")))))
    (None
     (cond
       ((text? n) (stringbuilder-add-string! sb (escape-html (text-value n))))
       ((comment? n)
        (stringbuilder-add-string! sb "<!--")
        (stringbuilder-add-string! sb (comment-value n))
        (stringbuilder-add-string! sb "-->"))
       ;; A processing instruction means nothing in HTML.
       (else unit)))))

;; Children among which there is a block go a block to a line: a newline
;; before each block, before what follows one, and — inside an element —
;; before its end tag. Text before the first block stays on the start tag's
;; line, which is how a list item with a list in it is written. Nothing
;; inside a <pre> is moved.
(: write-children! (-> StringBuilder (List Node) bool bool void))
(defun (write-children! sb kids inside? pre?)
  (def shown (list-filter shown? kids))
  (def blocks? (and (not pre?)
                    (loop (:for k shown) (:acc any (folding #f (or any (block-node? k)))))))
  (def after-block
    (loop (:for k shown)
          (:for i (up-from 0))
          (:acc prev (folding #f
                              (let ((block (block-node? k)))
                                (when (and blocks? (or block prev) (or inside? (> i 0)))
                                  (stringbuilder-add-string! sb "\n"))
                                (write-node! sb k pre?)
                                block)))))
  (when (and blocks? inside?) (stringbuilder-add-string! sb "\n")))

;; Nodes written as HTML: a fragment, a block to a line.
(: nodes->html (-> (List Node) string))
(defun (nodes->html nodes)
  (def sb (stringbuilder-empty))
  (write-children! sb nodes #f #f)
  (stringbuilder->string sb))
