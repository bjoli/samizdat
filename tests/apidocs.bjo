;; samizdat/tests/apidocs.bjo — Bjolang modules' docs in a document.
;;
;;     bjo run tests/apidocs.bjo
;;
;; The module shown is tests/fixtures/apidoc-lib.bjo, which this file imports
;; so that building the test builds its dll. A module by name is (janitor
;; docs), which every installation has.

(import (std prelude))
(import (std simpletest))
(import (samizdat doc))
(import (samizdat expand))
(import (samizdat commands))
(import "fixtures/apidoc-lib.bjo")

;; Read as if it were tests/post.sz, so that a path is relative to tests/.
(: tree (-> string string))
(defun (tree text)
  (match (read-document text standard-commands #:name "tests/post.sz" #:typography #f)
    ((Ok d) (document->sexp d))
    ((Err e) (str "error: " e))))

(: refusal (-> string string))
(defun (refusal text)
  (match (read-document text standard-commands #:name "tests/post.sz")
    ((Ok d) (str "no error: " (document->sexp d)))
    ((Err e) e)))

(: lib string)
(def lib "@defmodule[\"fixtures/apidoc-lib.bjo\"]\n")

(defun (main args)
  (expect "the fixture is what it documents" (bound 0 10 50) 10)

  (expect "the module's doc, its markup expanded, and the body"
          (tree "@defmodule[\"fixtures/apidoc-lib.bjo\"]{More.}")
          "(div \"doc-module\" (para \"Things to \" (em \"document\") \".\") (para \"See also: \" (code \"bound\")) (para \"More.\"))")

  (expect "a function: its heading, kind, code, terms in order, example, and what the document adds"
          (tree (str lib "@defdoc[bound]{Added.}"))
          (str "(div \"doc-module\" (para \"Things to \" (em \"document\") \".\") (para \"See also: \" (link \"#apidoc-lib-bound\" (code \"bound\"))))\n"
               "(div \"doc-entry\" (heading 4 \"apidoc-lib-bound\" (code \"bound\")) (para (span \"doc-kind\" \"function\"))"
               " (codeblock \"bjolang\" \"(: bound (-> int int int (#:scale int) int))\\n(bound lo hi x #:scale 1)\")"
               " (para \"A number kept between two others.\")"
               " (deflist (entry (term (code \"lo\")) (def (para \"The least.\"))) (entry (term (code \"hi\")) (def (para \"The most.\")))"
               " (entry (term (code \"x\")) (def (para \"The number.\"))) (entry (term (code \"#:scale\")) (def (para \"Multiplied in first.\")))"
               " (entry (term (em \"returns\")) (def (para \"x, kept between lo and hi.\")))"
               " (entry (term (em \"raises\") \" \" (code \"System.ArgumentException\")) (def (para \"When lo is more than hi.\"))))"
               " (codeblock \"bjolang\" \"(bound 0 10 50) ; 10\")"
               " (para \"See also: \" (code \"Point\") \", \" (code \"with-twice\")) (para \"Added.\"))"))

  (def all (tree (str lib "@defdocs[#:level 3]")))
  (def lines (string-split all "\n"))
  (expect "the module, then every definition" (vec-length lines) 4)
  (expect "the module first" (string-starts-with? (vec-ref lines 0) "(div \"doc-module\"") #t)
  (expect "then the definitions in the module's order, at the level asked for"
          (list (string-starts-with? (vec-ref lines 1) "(div \"doc-entry\" (heading 3 \"apidoc-lib-bound\" (code \"bound\"))")
                (string-starts-with? (vec-ref lines 2) "(div \"doc-entry\" (heading 3 \"apidoc-lib-point\" (code \"Point\"))")
                (string-starts-with? (vec-ref lines 3) "(div \"doc-entry\" (heading 3 \"apidoc-lib-with-twice\" (code \"with-twice\"))"))
          (list #t #t #t))
  (expect "see links to the definitions shown, before or after"
          (string-contains? all "(para \"See also: \" (link \"#apidoc-lib-point\" (code \"Point\")) \", \" (link \"#apidoc-lib-with-twice\" (code \"with-twice\")))")
          #t)
  (expect "a record: its fields, and no code"
          (string-contains? all "(heading 3 \"apidoc-lib-point\" (code \"Point\")) (para (span \"doc-kind\" \"record\")) (para \"A point.\") (deflist (entry (term (code \"x\"))")
          #t)
  (expect "a macro: how it is written, and its rest variable"
          (string-contains? all "(codeblock \"bjolang\" \"(with-twice body ...)\") (para \"Runs a body twice.\") (deflist (entry (term (code \"body ...\"))")
          #t)

  (expect "a link to a definition shown later, with its name or its own text"
          (vec-ref (string-split (tree (str lib "@docref[Point] and @docref[with-twice]{the macro}\n@defdocs")) "\n") 1)
          "(para (link \"#apidoc-lib-point\" (code \"Point\")) \" and \" (link \"#apidoc-lib-with-twice\" \"the macro\"))")

  (def by-name (tree "@defmodule[(janitor docs)]\n@docref[module-docs]\n@defdoc[module-docs]"))
  (expect "a module by name, found in the installed library"
          (vec-ref (string-split by-name "\n") 1)
          "(para (link \"#janitor-docs-module-docs\" (code \"module-docs\")))")
  (expect "its definition's code"
          (string-contains? by-name "(codeblock \"bjolang\" \"(: module-docs (-> (List PackageRoot) (List Symbol) (Result string (Vec Doc))))\\n(module-docs roots name)\")")
          #t)
  (expect "#:module names another module than @defmodule's"
          (string-starts-with? (tree (str lib "@defdoc[module-docs #:module (janitor docs)]"))
                               "(div \"doc-module\" (para \"Things to")
          #t)

  ;; --- refusals -----------------------------------------------------------
  (expect "no module yet" (refusal "@defdoc[bound]")
          "tests/post.sz:1:1: @defdoc: names no module: write @defmodule[(the module)] before it, or give it #:module")
  (expect "no such definition" (refusal (str lib "@defdoc[nothing]"))
          "tests/post.sz:2:1: @defdoc: fixtures/apidoc-lib.bjo has no doc for nothing")
  (expect "shown twice" (refusal (str lib "@defdoc[bound]\n@defdoc[bound]"))
          "tests/post.sz:3:1: @defdoc: bound of fixtures/apidoc-lib.bjo is shown twice in this document")
  (expect "a link to what is not shown" (refusal (str lib "@docref[Point]"))
          "tests/post.sz:2:1: @docref: Point of fixtures/apidoc-lib.bjo is not shown in this document: @defdoc it")
  (expect "no package" (refusal "@defmodule[(nopackage here)]")
          "tests/post.sz:1:1: @defmodule: no package provides (nopackage here)")
  (expect "not compiled"
          (string-starts-with? (refusal "@defmodule[\"fixtures/none.bjo\"]")
                               "tests/post.sz:1:1: @defmodule: fixtures/none.bjo is not compiled: there is no /")
          #t)
  (expect "not a module" (refusal "@defmodule[12]")
          "tests/post.sz:1:1: @defmodule: a module is a name, (std random), or the path of its source, and not 12")
  0)
