;; samizdat/tests/expand.bjo — commands, paragraphs and typography.
;;
;;     bjo run tests/expand.bjo
;;
;; Each check reads markup, runs the standard commands on it, and compares the
;; tree that came out, written as s-expressions by `document->sexp`: one block
;; to a line, then the notes.

(import (std prelude))
(import (std simpletest))
(import (samizdat read))
(import (samizdat doc))
(import (samizdat expand))
(import (samizdat commands))

(: tree-with (-> (Map string Command) bool string string))
(defun (tree-with commands typography text)
  (match (read-document text commands #:name "post.sz" #:typography typography)
    ((Ok d) (document->sexp d))
    ((Err e) (str "error: " e))))

;; The tree, dashes and quotes as they were typed.
(: tree (-> string string))
(defun (tree text) (tree-with standard-commands #f text))

;; The tree with the typography pass.
(: smart (-> string string))
(defun (smart text) (tree-with standard-commands #t text))

;; The message, or the tree when there was none.
(: refusal (-> string string))
(defun (refusal text)
  (match (read-document text standard-commands #:name "post.sz")
    ((Ok d) (str "no error: " (document->sexp d)))
    ((Err e) e)))

;; The tree of a document read from a file, or the error. The files are under
;; tests/fixtures/, and the tests are run from the package's directory.
(: file-tree (-> string string))
(defun (file-tree path)
  (match (read-document-file path standard-commands #:typography #f)
    ((Ok d) (document->sexp d))
    ((Err e) (str "error: " e))))

;; --- commands of the test's own -------------------------------------------

;; `@em` replaced: louder.
(: shout (-> Ctx Call (Vec Piece)))
(defun (shout cx c) (inline (Strong (expand-inlines cx c))))

;; A command that runs itself again, which only the depth limit stops.
(: again (-> Ctx Call (Vec Piece)))
(defun (again cx c) (expand-items cx (vec-add (vec-empty) (Cmd c))))

;; `@version["1.2"]`: an argument, checked.
(: version (-> Ctx Call (Vec Piece)))
(defun (version cx c)
  (check-keywords! cx c ["prefix"])
  (inline (Code (str (kw-string-or cx c "prefix" "v") (arg-string cx c 0)))))

(def mine
  (map-merge standard-commands
             #map(("bjo" (text-command "Bjolang"))
                  ("em" shout)
                  ("again" again)
                  ("version" version))))

(defun (main args)
  ;; --- paragraphs ---------------------------------------------------------
  (expect "a blank line between paragraphs, and any number of them"
          (tree "One.\n\nTwo\nlines.\n\n\n   \nThree.")
          "(para \"One.\")\n(para \"Two\\nlines.\")\n(para \"Three.\")")
  (expect "space around a paragraph is not part of it"
          (tree "\n\n   Text.   \n\n")
          "(para \"Text.\")")
  (expect "a block ends a paragraph without a blank line"
          (tree "Before\n@section{The Title}\nAfter")
          "(para \"Before\")\n(heading 1 \"the-title\" \"The Title\")\n(para \"After\")")
  (expect "a blank line split by a comment is still one"
          (tree "a\n@; hidden\n\nb")
          "(para \"a\")\n(para \"b\")")
  (expect "@comment is nothing"
          (tree "a @comment{x @em{y}} b")
          "(para \"a  b\")")

  ;; --- text ---------------------------------------------------------------
  (expect "emphasis, nested"
          (tree "Some @em{emphasis} and @strong{strong @em{nested}}.")
          "(para \"Some \" (em \"emphasis\") \" and \" (strong \"strong \" (em \"nested\")) \".\")")
  (expect "code is taken as written"
          (tree "Call @code{f {x}} or @code|{g @x}|.")
          "(para \"Call \" (code \"f {x}\") \" or \" (code \"g @x\") \".\")")
  (expect "a link, and one whose url is its text"
          (tree "@link[\"https://a.example\"]{here} and @link[\"https://b.example\"]")
          "(para (link \"https://a.example\" \"here\") \" and \" (link \"https://b.example\" \"https://b.example\"))")
  (expect "an image"
          (tree "@image[\"cat.png\" #:alt \"A cat\"]")
          "(para (image \"cat.png\" \"A cat\"))")
  (expect "a line break"
          (tree "one @br two")
          "(para \"one \" (br) \" two\")")
  (expect "a span and a div have a class"
          (tree "@div[aside]{Press @span[\"kbd\"]{C-x}.}")
          "(div \"aside\" (para \"Press \" (span \"kbd\" \"C-x\") \".\"))")
  (expect "raw text and a raw block are for one format"
          (tree "a @raw[\"html\"]{<wbr>} b\n@raw-block[\"html\"]|{<hr class=\"x\">}|")
          "(para \"a \" (raw \"html\" \"<wbr>\") \" b\")\n(raw-block \"html\" \"<hr class=\\\"x\\\">\")")

  ;; --- blocks -------------------------------------------------------------
  (expect "headings at three levels, each id unique, or chosen"
          (tree "@section{A}\n@section{A}\n@subsection[#:id \"mine\"]{B}\n@subsubsection{C, d!}")
          "(heading 1 \"a\" \"A\")\n(heading 1 \"a-2\" \"A\")\n(heading 2 \"mine\" \"B\")\n(heading 3 \"c-d\" \"C, d!\")")
  (expect "a code block, indented with the markup"
          (tree "Look:\n\n  @codeblock[#:lang \"scheme\"]|{\n    (define (f x)\n      x)\n  }|")
          "(para \"Look:\")\n(codeblock \"scheme\" \"(define (f x)\\n  x)\")")
  (expect "a quotation holds paragraphs"
          (tree "@blockquote{\n  Quoted.\n\n  Twice.\n}")
          "(quote (para \"Quoted.\") (para \"Twice.\"))")
  (expect "a list, an item with two paragraphs"
          (tree "@itemlist{\n  @item{One}\n  @item{Two\n\n    paras}\n}")
          "(bullets (item (para \"One\")) (item (para \"Two\") (para \"paras\")))")
  (expect "a numbered list"
          (tree "@itemlist[#:style ordered]{@item{a} @item{b}}")
          "(numbered (item (para \"a\")) (item (para \"b\")))")
  (expect "a rule"
          (tree "a\n@hr\nb")
          "(para \"a\")\n(rule)\n(para \"b\")")

  ;; --- notes ----------------------------------------------------------------
  (expect "footnotes are numbered as they come, a note in a note after it"
          (tree "Text.@note{A note.\n\nIn two paragraphs.} More.@note{Second@note{nested}}")
          (str "(para \"Text.\" (note-ref 1) \" More.\" (note-ref 2))\n"
               "(notes (note 1 (para \"A note.\") (para \"In two paragraphs.\"))"
               " (note 2 (para \"Second\" (note-ref 3))) (note 3 (para \"nested\")))"))

  ;; --- typography ---------------------------------------------------------
  (expect "quotes curl, dashes and dots join, across an inline"
          (smart "She said \"hi\" -- then --- left... It's '@em{x}'.")
          "(para \"She said “hi” – then — left… It’s ‘\" (em \"x\") \"’.\")")
  (expect "not in code"
          (smart "@code{a -- \"b\"}\n@codeblock|{c --- 'd'}|")
          "(para (code \"a -- \\\"b\\\"\"))\n(codeblock \"\" \"c --- 'd'\")")
  (expect "headings and notes too"
          (smart "@section{\"A\"}\nx@note{\"n\"}")
          "(heading 1 \"a\" \"“A”\")\n(para \"x\" (note-ref 1))\n(notes (note 1 (para \"“n”\")))")

  ;; --- a table of one's own --------------------------------------------------
  (expect "a text command, and one that replaces a standard one"
          (tree-with mine #f "I like @bjo and @em{this}.")
          "(para \"I like Bjolang and \" (strong \"this\") \".\")")
  (expect "arguments and keywords, read by the command"
          (tree-with mine #f "@version[\"1.2\"] @version[\"2\" #:prefix \"r\"]")
          "(para (code \"v1.2\") \" \" (code \"r2\"))")
  (expect-true "a command that runs itself is stopped"
               (string-contains? (tree-with mine #f "x @again")
                                 "post.sz:1:3: @again: commands are running more than 200 deep"))

  ;; --- meta -------------------------------------------------------------------
  (match (read-document "(meta (title \"Hi there\") (tags web http))\nText." standard-commands)
    ((Err e) (fail (str "meta: " e)))
    ((Ok d)
     (expect "a meta string" (meta-string d "title") (Some "Hi there"))
     (expect "meta strings" (string-join (meta-strings d "tags") ",") "web,http")
     (expect "no such clause" (meta-string d "date") None)
     (expect "and the body after it" (document->sexp d) "(para \"Text.\")")))

  ;; --- refusals ---------------------------------------------------------------
  (expect "a command nobody defined, and where it is"
          (refusal "a\n  @nope{x}")
          "post.sz:2:3: @nope: there is no such command")
  (expect "a missing argument"
          (refusal "@link{x}")
          "post.sz:1:1: @link: needs 1 argument in its [...]")
  (expect "a misspelt keyword"
          (refusal "@codeblock[#:langauge \"x\"]{y}")
          "post.sz:1:1: @codeblock: takes no #:langauge; it takes #:lang, #:file")
  (expect "a keyword with no value"
          (refusal "@codeblock[#:lang]{y}")
          "post.sz:1:1: @codeblock: #:lang has no value after it")
  (expect "a keyword of the wrong kind"
          (refusal "@image[\"x.png\" #:alt 5]")
          "post.sz:1:1: @image: #:alt should be a string, and is 5")
  (expect "a block where only text can go"
          (refusal "x @em{a @section{b}}")
          "post.sz:1:3: @em: has a block in it, where only text can go")
  (expect "an item outside a list"
          (refusal "@item{x}")
          "post.sz:1:1: @item: belongs inside an @itemlist")
  (expect "text in a list"
          (refusal "@itemlist{@item{a} b}")
          "post.sz:1:1: @itemlist: holds only @item{...}, and there is text in it")
  (expect "a body where none is taken"
          (refusal "@hr{x}")
          "post.sz:1:1: @hr: takes no body")
  (expect-true "the reader's refusals come through as they are"
               (string-starts-with? (refusal "@em{x") "post.sz: Parse error at line 1"))

  ;; --- a table of contents ------------------------------------------------------
  (expect "@toc lists sections and subsections, nested, and not what is deeper"
          (tree "@toc\n@section{One}\n@subsection{One A}\n@subsubsection{Deep}\n@section{Two}")
          (str "(div \"toc\" (bullets (item (para (link \"#one\" \"One\"))"
               " (bullets (item (para (link \"#one-a\" \"One A\")))))"
               " (item (para (link \"#two\" \"Two\")))))\n"
               "(heading 1 \"one\" \"One\")\n(heading 2 \"one-a\" \"One A\")\n"
               "(heading 3 \"deep\" \"Deep\")\n(heading 1 \"two\" \"Two\")"))
  (expect "#:depth 3 lists those too"
          (vec-ref (string-split (tree "@toc[#:depth 3]\n@section{One}\n@subsection{One A}\n@subsubsection{Deep}") "\n") 0)
          (str "(div \"toc\" (bullets (item (para (link \"#one\" \"One\"))"
               " (bullets (item (para (link \"#one-a\" \"One A\"))"
               " (bullets (item (para (link \"#deep\" \"Deep\")))))))))"))
  (expect "a subsection before any section is an item of its own"
          (vec-ref (string-split (tree "@toc\n@subsection{A}\n@section{B}") "\n") 0)
          "(div \"toc\" (bullets (item (bullets (item (para (link \"#a\" \"A\"))))) (item (para (link \"#b\" \"B\")))))")
  (expect "no headings, no table"
          (tree "@toc\nText.")
          "(para \"Text.\")")
  (expect "the headings of an included file are in it"
          (vec-ref (string-split (tree "@toc\n@include[\"tests/fixtures/chapter.sz\"]") "\n") 0)
          "(div \"toc\" (bullets (item (para (link \"#included\" \"Included\")))))")

  ;; --- references -----------------------------------------------------------------
  (expect "@ref says the heading's title, or its own, and may come first"
          (tree "See @ref[\"later\"] and @ref[\"later\"]{this}.\n@section[#:id \"later\"]{The Later One}")
          (str "(para \"See \" (link \"#later\" \"The Later One\") \" and \" (link \"#later\" \"this\") \".\")\n"
               "(heading 1 \"later\" \"The Later One\")"))
  (expect "a reference to no heading"
          (refusal "@ref[\"nope\"]")
          "post.sz:1:1: @ref: there is no heading with the id nope")
  (expect "one in an included file names that file"
          (refusal "@include[\"tests/fixtures/ref-bad.sz\"]")
          "tests/fixtures/ref-bad.sz:1:6: @ref: there is no heading with the id missing")

  ;; --- including ------------------------------------------------------------------
  (expect "an included file is as if written in place, sharing notes and ids"
          (file-tree "tests/fixtures/main.sz")
          (str "(para \"Before.\")\n(heading 1 \"included\" \"Included\")\n"
               "(para \"Text from the chapter.\" (note-ref 1))\n(para \"After.\" (note-ref 2))\n"
               "(notes (note 1 (para \"A note in the chapter.\")) (note 2 (para \"Main's note.\")))"))
  (expect "a path is relative to the file that has it"
          (file-tree "tests/fixtures/nested.sz")
          "(para \"Inner.\")\n(para \"Leaf.\")")
  (expect "a file that is not there"
          (refusal "@include[\"tests/fixtures/nope.sz\"]")
          "post.sz:1:1: @include: there is no file tests/fixtures/nope.sz")
  (expect "a file that includes itself, however far round"
          (file-tree "tests/fixtures/loop-a.sz")
          (str "error: tests/fixtures/loop-b.sz:1:1: @include: tests/fixtures/loop-a.sz is already being included:"
               " tests/fixtures/loop-a.sz -> tests/fixtures/loop-b.sz -> tests/fixtures/loop-a.sz\n"
               "  included from tests/fixtures/loop-a.sz:1:1"))
  (expect "an included file may not have a meta form"
          (refusal "@include[\"tests/fixtures/with-meta.sz\"]")
          "post.sz:1:1: @include: tests/fixtures/with-meta.sz begins with (meta ...), which only the document itself may")
  (expect "a refusal inside one says where it was included from"
          (refusal "x\n@include[\"tests/fixtures/broken.sz\"]")
          "tests/fixtures/broken.sz:2:1: @nope: there is no such command\n  included from post.sz:2:1")
  (expect-true "and so does one that cannot be read"
               (string-starts-with? (refusal "@include[\"tests/fixtures/unclosed.sz\"]")
                                    "post.sz:1:1: @include: tests/fixtures/unclosed.sz: Parse error at line 2"))
  (expect "code from a file"
          (tree "@codeblock[#:lang \"scheme\" #:file \"tests/fixtures/snippet.scm\"]")
          "(codeblock \"scheme\" \"(define (f x)\\n  x)\")")
  (expect "but not from a file and a body"
          (refusal "@codeblock[#:file \"tests/fixtures/snippet.scm\"]{x}")
          "post.sz:1:1: @codeblock: takes its code from #:file or from its body, not both")

  ;; --- lists as Markdown and Org write them ------------------------------------
  (expect "the example: a nested list, and an item that goes on"
          (tree "@read-list{\n- this parses things\n  - a list with nested lists\n- this is another post\n  and this continues the list item above.\n}")
          (str "(bullets (item (para \"this parses things\") (bullets (item (para \"a list with nested lists\"))))"
               " (item (para \"this is another post\\nand this continues the list item above.\")))"))
  (expect "numbered, with . or )"
          (tree "@read-list{\n1. one\n2) two\n}")
          "(numbered (item (para \"one\")) (item (para \"two\")))")
  (expect "+ and * are bullets too, and a numbered list may be inside"
          (tree "@read-list{\n+ a\n  1. b\n  2. c\n* d\n}")
          "(bullets (item (para \"a\") (numbered (item (para \"b\")) (item (para \"c\")))) (item (para \"d\")))")
  (expect "a line of text goes on with its item, however it is indented"
          (tree "@read-list{\n- one\ncontinues here\n-x is not a marker\n- two\n}")
          "(bullets (item (para \"one\\ncontinues here\\n-x is not a marker\")) (item (para \"two\")))")
  (expect "after a blank line, indented text is a paragraph of the item"
          (tree "@read-list{\n- one\n\n  second paragraph\n\n- two\n}")
          "(bullets (item (para \"one\") (para \"second paragraph\")) (item (para \"two\")))")
  (expect "three deep, the whole list indented in its braces"
          (tree "@read-list{\n  - a\n    - b\n      - c\n  - d\n}")
          "(bullets (item (para \"a\") (bullets (item (para \"b\") (bullets (item (para \"c\")))))) (item (para \"d\")))")
  (expect "commands in items"
          (tree "@read-list{\n- @em{x} and @code{y}\n- see @link[\"u\"]{z}\n}")
          "(bullets (item (para (em \"x\") \" and \" (code \"y\"))) (item (para \"see \" (link \"u\" \"z\"))))")
  (expect "an empty one is nothing"
          (tree "@read-list{}")
          "")
  (expect "a list begins with an item"
          (refusal "@read-list{\nIntro\n- a\n}")
          "post.sz:1:1: @read-list: begins with text, and a list begins with - or 1.: \"Intro\"")
  ;; --- tables as Org writes them -----------------------------------------------
  (expect "an Org table: a caption, a head, commands in cells, numbers to the right"
          (tree (str "@read-table{\n#+CAPTION: What they drink\n| Name  | Cups | Of       |\n"
                     "|-------+------+----------|\n| Alice |    3 | @em{tea} |\n| Bob   |   12 | coffee   |\n}"))
          (str "(table (aligns default right default) (caption \"What they drink\")"
               " (head (row (cell \"Name\") (cell \"Cups\") (cell \"Of\")))"
               " (body (row (cell \"Alice\") (cell \"3\") (cell (em \"tea\")))"
               " (row (cell \"Bob\") (cell \"12\") (cell \"coffee\"))))"))
  (expect "Markdown's delimiter row is a rule, and its colons align"
          (tree "@read-table{\n| Left | Center | Right |\n|:-----|:------:|------:|\n| a | b | c |\n}")
          (str "(table (aligns left center right) (head (row (cell \"Left\") (cell \"Center\") (cell \"Right\")))"
               " (body (row (cell \"a\") (cell \"b\") (cell \"c\"))))"))
  (expect "rules around and between, groups, and a row of cookies"
          (tree "@read-table{\n|---+---|\n| <l> | <r5> |\n| a | b |\n|---+---|\n| 1 | x |\n|---+---|\n| 2 | y |\n|---+---|\n}")
          (str "(table (aligns left right) (head (row (cell \"a\") (cell \"b\")))"
               " (body (row (cell \"1\") (cell \"x\"))) (body (row (cell \"2\") (cell \"y\"))))"))
  (expect "no rule, no head; \\| in a cell; a short row filled; #:caption; #+ lines passed over"
          (tree "@read-table[#:caption \"Pipes\"]{\n#+NAME: pipes\n| a \\| b | c |\n| d |\n#+TBLFM: $2=1\n}")
          (str "(table (aligns default default) (caption \"Pipes\")"
               " (body (row (cell \"a | b\") (cell \"c\")) (row (cell \"d\") (cell))))"))
  (expect-true "a column that is more than half numbers, as Org counts them"
               (string-starts-with? (tree "@read-table{\n| x | 1,234.5 |\n| y | -2% |\n| z | n/a |\n}")
                                    "(table (aligns default right)"))
  (expect "an empty table is nothing"
          (tree "@read-table{}")
          "")
  (expect "a line that is not a row"
          (refusal "@read-table{\n| a |\nnot a row\n}")
          "post.sz:1:1: @read-table: has a line that is not a row, a rule or a #+ line: \"not a row\"")

  (expect "text after a blank line, and not indented under an item"
          (refusal "@read-list{\n- a\n\nafter\n}")
          (str "post.sz:1:1: @read-list: has a line in no item: \"after\". After a blank line,"
               " text is in an item when it is indented past the item's marker"))

  (println "expand ok")
  0)
