;; samizdat/tests/html.bjo — the HTML converter.
;;
;;     bjo run tests/html.bjo
;;
;; Markup in, through the standard commands, and the HTML out compared as
;; text. Typography is off, so that the quotes in the markup are the ones in
;; the checks.

(import (std prelude))
(import (std simpletest))
(import (samizdat doc))
(import (samizdat expand))
(import (samizdat commands))
(import (samizdat html))

(: doc-of (-> string Document))
(defun (doc-of text)
  (match (read-document text standard-commands #:typography #f)
    ((Ok d) d)
    ((Err e) (Document (meta None) (blocks [(Para [(Str (str "error: " e))])]) (notes (vec-empty))))))

(: html-with (-> Html string string))
(defun (html-with h text) (document->html (doc-of text) #:with h))

(: html-of (-> string string))
(defun (html-of text) (html-with default-html text))

;; --- hooks --------------------------------------------------------------------

;; A div of class aside is an <aside>; its blocks are written by the converter.
(: asides (-> Html Block (Option string)))
(defun (asides h b)
  (match b
    ((Div "aside" bs) (Some (str "<aside>\n" (blocks->html h bs) "\n</aside>")))
    (_ None)))

;; A span of class kbd is a <kbd>.
(: keys (-> Html Inline (Option string)))
(defun (keys h i)
  (match i
    ((Span "kbd" xs) (Some (str "<kbd>" (inlines->html h xs) "</kbd>")))
    (_ None)))

(defun (main args)
  ;; --- text -----------------------------------------------------------------
  (expect "a paragraph, emphasis, and what must be escaped"
          (html-of "Hi @em{there} & <you>, @strong{bold}.")
          "<p>Hi <em>there</em> &amp; &lt;you&gt;, <strong>bold</strong>.</p>")
  (expect "code, escaped"
          (html-of "Use @code{(< a b)}.")
          "<p>Use <code>(&lt; a b)</code>.</p>")
  (expect "a link and an image, their attributes escaped"
          (html-of "@link[\"/a?b=1&c=\\\"d\\\"\"]{x} @image[\"cat.png\" #:alt \"A \\\"cat\\\"\"]")
          "<p><a href=\"/a?b=1&amp;c=&quot;d&quot;\">x</a> <img src=\"cat.png\" alt=\"A &quot;cat&quot;\"></p>")
  (expect "a line break"
          (html-of "one@|br|two")
          "<p>one<br>two</p>")

  ;; --- blocks -----------------------------------------------------------------
  (expect "a section is an h2 under the page's h1"
          (html-of "@section{The Title}\n@subsection{Below}")
          "<h2 id=\"the-title\">The Title</h2>\n<h3 id=\"below\">Below</h3>")
  (expect "#:heading-offset 0 makes it an h1, and no level goes past h6"
          (html-with (html-options #:heading-offset 0) "@section{A}")
          "<h1 id=\"a\">A</h1>")
  (expect "no level goes past h6"
          (html-with (html-options #:heading-offset 5) "@subsubsection{A}")
          "<h6 id=\"a\">A</h6>")
  (expect "a code block, with the class highlighters look for"
          (html-of "@codeblock[#:lang \"scheme\"]|{\n  (if (< a b)\n      a)\n}|")
          "<pre><code class=\"language-scheme\">(if (&lt; a b)\n    a)</code></pre>")
  (expect "and without a language"
          (html-of "@codeblock|{x}|")
          "<pre><code>x</code></pre>")
  (expect "a list of short items has no <p> in it"
          (html-of "@itemlist{@item{a} @item{b}}")
          "<ul>\n<li>a</li>\n<li>b</li>\n</ul>")
  (expect "an item of two paragraphs has"
          (html-of "@itemlist[#:style ordered]{@item{a} @item{b\n\nc}}")
          "<ol>\n<li>a</li>\n<li>\n<p>b</p>\n<p>c</p>\n</li>\n</ol>")
  (expect "a quotation"
          (html-of "@blockquote{Quoted.}")
          "<blockquote>\n<p>Quoted.</p>\n</blockquote>")
  (expect "a div and a span have their class"
          (html-of "@div[aside]{Press @span[kbd]{C-x}.}")
          "<div class=\"aside\">\n<p>Press <span class=\"kbd\">C-x</span>.</p>\n</div>")
  (expect "a rule"
          (html-of "a\n@hr\nb")
          "<p>a</p>\n<hr>\n<p>b</p>")
  (expect "raw html passes through, and raw anything else is left out"
          (html-of "a @raw[html]{<wbr>}@raw[latex]{\\\\} b\n@raw-block[latex]{\\\\newpage}\n@raw-block[html]{<hr class=\"x\">}")
          "<p>a <wbr> b</p>\n<hr class=\"x\">")

  ;; --- notes ----------------------------------------------------------------
  (expect "footnotes: a reference, and the note with a way back"
          (html-of "Text.@note{A note.} More.@note{@codeblock|{x}|}")
          (str "<p>Text.<sup class=\"note-ref\"><a id=\"note-ref-1\" href=\"#note-1\">1</a></sup>"
               " More.<sup class=\"note-ref\"><a id=\"note-ref-2\" href=\"#note-2\">2</a></sup></p>\n"
               "<section class=\"notes\">\n<ol>\n"
               "<li id=\"note-1\">\n<p>A note. <a class=\"note-back\" href=\"#note-ref-1\">↩</a></p>\n</li>\n"
               "<li id=\"note-2\">\n<pre><code>x</code></pre>\n<a class=\"note-back\" href=\"#note-ref-2\">↩</a>\n</li>\n"
               "</ol>\n</section>"))
  (expect "#:id-prefix, for two documents on one page"
          (html-with (html-options #:id-prefix "p7-") "@section{A}\nx@note{n}")
          (str "<h2 id=\"p7-a\">A</h2>\n"
               "<p>x<sup class=\"note-ref\"><a id=\"p7-note-ref-1\" href=\"#p7-note-1\">1</a></sup></p>\n"
               "<section class=\"notes\">\n<ol>\n"
               "<li id=\"p7-note-1\">\n<p>n <a class=\"note-back\" href=\"#p7-note-ref-1\">↩</a></p>\n</li>\n"
               "</ol>\n</section>"))

  ;; --- hooks ------------------------------------------------------------------
  (expect "hooks take over a block and an inline, and hand the rest back"
          (html-with (html-options #:block-hook asides #:inline-hook keys)
                     "@div[aside]{Press @span[kbd]{C-x} @em{now}.}\n@div[other]{x}")
          (str "<aside>\n<p>Press <kbd>C-x</kbd> <em>now</em>.</p>\n</aside>\n"
               "<div class=\"other\">\n<p>x</p>\n</div>"))

  ;; --- a page -------------------------------------------------------------------
  (let ((page (html-page (doc-of "(meta (title \"Fish & chips\"))\nText.")
                         #:head "<link rel=\"stylesheet\" href=\"/site.css\">")))
    (expect-true "a page begins with its doctype" (string-starts-with? page "<!DOCTYPE html>\n<html lang=\"en\">"))
    (expect-true "its title from the meta form, escaped" (string-contains? page "<title>Fish &amp; chips</title>"))
    (expect-true "what #:head says, in the head" (string-contains? page "<link rel=\"stylesheet\" href=\"/site.css\">\n</head>"))
    (expect-true "and the document in its body" (string-contains? page "<body>\n<p>Text.</p>\n</body>")))
  (expect-true "#:title wins over the meta form"
               (string-contains? (html-page (doc-of "(meta (title \"No\"))") #:title "Yes") "<title>Yes</title>"))

  (println "html ok")
  0)
